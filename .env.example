# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nursepath"

# Apps
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000

# Auth (admin JWT)
JWT_SECRET=
JWT_EXPIRY=24h

# Auth.js (user sessions) — generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Email (Phase 4 — Resend)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=NursePath <onboarding@resend.dev>
CONTACT_TO_EMAIL=support@nursepath.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@nursepath.com

# Uploads
# Public store — previews, thumbnails, guide PDFs
BLOB_READ_WRITE_TOKEN=
# Private store — library full PDFs only (create a Private Blob store in Vercel Storage)
BLOB_LIBRARY_READ_WRITE_TOKEN=

# Cron (Phase 5 — expiry reminder emails)
CRON_SECRET=
